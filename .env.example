# --- Telegram ---
BOT_TOKEN=your_bot_token_here

# --- Have I Been Pwned (проверка email) ---
# Ключ: https://haveibeenpwned.com/API/Key — без него проверка email вернёт пусто
HIBP_API_KEY=your_hibp_api_key_here

# --- SMTP для отправки кодов подтверждения на email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=bot@example.com
SMTP_USE_TLS=true
